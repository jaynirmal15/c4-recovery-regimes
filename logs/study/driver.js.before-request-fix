// C4 policy driver (STAGE-A-SPEC §1). Stack-agnostic; identical on both stacks.
'use strict';

(() => {
  const P = { ladder: 'v2', waitMs: 5000, retryMs: 5000, escalateMs: 30000, giveUpMs: 120000, signalTimeoutMs: 15000, mediaAgeMs: 2000, healthySustainMs: 1000, signalGapMs: 7000, mediaGapMs: 1500 };

  // ---- attribution: any recovery entry while no driver action is active is a violation ----
  const VIOLATIONS = [];
  const attribution = {
    active: null,
    check(where, info = {}, exempt = false) {
      const e = { t: C4X.now(), where, by: this.active ? `driver:${this.active}` : 'NOT-DRIVER', ...info };
      C4X.log('attribution', e);
      if (!this.active && !exempt) { VIOLATIONS.push(e); C4X.log('VIOLATION', e); }
    },
    async run(label, fn) { this.active = label; try { return await fn(); } finally { this.active = null; } },
  };

  let adapter = null, cfg = null, role = null;
  const D = { state: 'idle', armed: false, tDetect: null, actions: [], history: [], healthySince: null, gaveUp: false, busy: false, serverRequests: [], terminals: [] };
  const setState = (s, extra = {}) => { D.state = s; const e = C4X.log('driver_state', { state: s, ...extra }); D.history.push(e); };

  // Subject: all remotes. Observer: its OWN connection and the OTHER observer only; the
  // subject's media going stale is the measurement, not an observer failure (spec §1.4).
  function health() {
    const now = C4X.now();
    // Joined is required: a fresh session that has not (yet) joined, e.g. refused with 436,
    // is NOT healthy (bug found in the 2026-09-30 targeted tests).
    const joined = adapter.isJoined();
    const signalOk = joined && now - adapter.lastReplyAt < P.signalTimeoutMs && !adapter.isTerminated();
    const pcsOk = adapter.pcsHealthy();
    const keys = role === 'subject' ? cfg.remotes : cfg.remotes.filter((k) => k !== cfg.subjectIdentity);
    const ages = Object.fromEntries(keys.map((k) => [k, C4X.effectiveAge(k)]));
    // After a recovery action, only media received AFTER the action started counts as fresh;
    // leftovers from the abandoned pipelines must not read as recovery.
    const since = D.lastActionStart || 0;
    const postAction = keys.every((k) => C4X.lastFresh[k] && C4X.lastFresh[k].tP > since);
    const mediaOk = pcsOk && postAction && Object.values(ages).every((a) => a <= P.mediaAgeMs);
    return { joined, signalOk, pcsOk, mediaOk, postAction, ages };
  }

  async function act(kind) {
    if (D.busy) return null;
    D.busy = true;
    const rec = { kind, tStart: C4X.now(), sid0: adapter.sessionId() };
    D.lastActionStart = rec.tStart;
    C4X.log('driver_action_begin', rec);
    let res;
    try { res = await attribution.run(kind, () => (kind === 'rebuild' ? adapter.rebuild() : adapter.transportRestart())); }
    catch (e) { res = { ok: false, detail: String(e && e.message || e) }; }
    Object.assign(rec, { tEnd: C4X.now(), result: res, sid1: adapter.sessionId() });
    D.actions.push(rec); C4X.log('driver_action_end', rec);
    D.busy = false;
    return rec;
  }

  const since = () => C4X.now() - D.tDetect;

  // Ladder v2 (STAGE-A-SPEC §1.1a): driver-owned evidence that connectivity has returned.
  // If signalling was lost (no reply > 7 s) the evidence is the first reply after that gap;
  // otherwise (media-only loss) it is the first decoded media sample after the gap.
  function trackConnectivity() {
    const now = C4X.now();
    const signalDead = now - adapter.lastReplyAt > P.signalGapMs;
    if (signalDead && !D.signalLost) { D.signalLost = true; C4X.log('signal_gap_seen', {}); }
    const newest = Math.max(0, ...cfg.remotes.map((k) => (C4X.lastFresh[k] ? C4X.lastFresh[k].tP : 0)));
    const mediaDead = now - newest > P.mediaGapMs;
    const dead = D.signalLost ? signalDead : mediaDead;
    if (dead) { D.wasDead = true; if (D.tReturn != null) { D.tReturn = null; C4X.log('connectivity_lost_again', {}); } }
    else if (D.wasDead && D.tReturn == null) { D.tReturn = now; C4X.log('connectivity_returned', { via: D.signalLost ? 'signalling reply' : 'media sample', sinceDetect: D.tDetect ? now - D.tDetect : null }); }
  }
  const resetOutage = () => { D.signalLost = false; D.wasDead = false; D.tReturn = null; };
  const lastOf = (k) => [...D.actions].reverse().find((a) => a.kind === k);

  async function tick() {
    if (!D.armed || role !== 'subject') { if (D.armed && role === 'observer') observerTick(); return; }
    const h = health();
    const healthy = h.signalOk && h.mediaOk;
    if (healthy) { D.healthySince = D.healthySince || C4X.now(); } else D.healthySince = null;
    const sustained = D.healthySince && C4X.now() - D.healthySince >= P.healthySustainMs;

    if (D.state === 'healthy') {
      if (!healthy) { D.tDetect = C4X.now(); resetOutage(); setState('detected', { signalOk: h.signalOk, pcsOk: h.pcsOk, ages: h.ages }); }
      return;
    }
    if (D.state === 'gaveup') return;
    trackConnectivity();
    if (sustained && !D.busy) { setState('healthy', { afterActions: D.actions.length }); D.tDetect = null; D.rebuilding = false; return; }
    if (D.busy) return;
    if (since() >= P.giveUpMs) { setState('gaveup'); return; }
    const last = D.actions[D.actions.length - 1];
    const retryReady = !last || C4X.now() - last.tEnd >= P.retryMs;
    // A transport restart needs a joined session; without one, the only move is rebuild.
    if ((D.state === 'detected' || D.state === 'restarting') && !adapter.isJoined() && since() >= P.waitMs) { setState('rebuilding', { why: 'not joined' }); await act('rebuild'); return; }
    if (D.state === 'detected' && since() >= P.waitMs) { setState('restarting'); await act('transport_restart'); return; }
    if (D.state === 'restarting') {
      const lr = lastOf('transport_restart');
      const refused = lr && lr.result && lr.result.refused;
      // v2: escalate by time only after a transport restart that STARTED after connectivity returned has failed
      const postReturnFailed = lr && lr.result && !lr.result.ok && D.tReturn != null && lr.tStart >= D.tReturn;
      if (refused || (since() >= P.escalateMs && postReturnFailed)) { setState('rebuilding', { why: refused ? `refused:${refused}` : 'escalate: post-return restart failed', tReturn: D.tReturn }); await act('rebuild'); return; }
      if (retryReady) await act('transport_restart');
      return;
    }
    if (D.state === 'rebuilding' && retryReady) { const lb = lastOf('rebuild'); if (!(lb && lb.result && lb.result.ok)) await act('rebuild'); }
  }

  function observerTick() {
    const h = health();
    const bad = !(h.signalOk && h.mediaOk);
    if (bad && !D.observerBadSince) D.observerBadSince = C4X.now();
    if (!bad) D.observerBadSince = null;
    // Spec §1.4/§3.3: observer detection (sustained past the detection thresholds) invalidates.
    if (D.observerBadSince && C4X.now() - D.observerBadSince > 1000 && !D.observerDetected) {
      D.observerDetected = { t: C4X.now(), ...h }; C4X.log('OBSERVER_DETECTION', D.observerDetected);
    }
  }

  function onServerRequest(kind, info) {
    const e = { t: C4X.now(), kind, ...info, arm: cfg.arm };
    D.serverRequests.push(e); C4X.log('server_request', e);
    if (role !== 'subject' || !D.armed || cfg.arm !== 'O') return; // arm I: record only
    D.tDetect = D.tDetect || C4X.now();
    if (kind === 'resume') { setState('restarting', { trigger: 'server_request' }); act('transport_restart'); }
    else { setState('rebuilding', { trigger: 'server_request' }); act('rebuild'); }
  }
  function onTerminal(info) {
    const e = { t: C4X.now(), ...info }; D.terminals.push(e); C4X.log('server_terminal', e);
    if (role !== 'subject' || !D.armed) return;
    D.tDetect = D.tDetect || C4X.now();
    setState('rebuilding', { trigger: 'terminal', reason: info.reason }); // spec §1.3: both arms
    act('rebuild');
  }

  window.C4 = {
    params: P,
    /** cfg: {stack, role:'subject'|'observer'|'intruder', arm:'O'|'I', identity, remotes:[...], lk:{url,token}, janus:{wsUrl, room, feedId}} */
    async join(c) {
      cfg = c; role = c.role;
      const common = { onServerRequest, onTerminal, attribution, signalTimeoutS: P.signalTimeoutMs / 1000 };
      adapter = c.stack === 'livekit'
        ? new window.LiveKitAdapter({ ...common, url: c.lk.url, token: c.lk.token, identity: c.identity, publish: c.publish !== false })
        : new window.JanusAdapter({ ...common, wsUrl: c.janus.wsUrl, room: c.janus.room, feedId: c.janus.feedId, display: c.identity, keepaliveMs: 5000 });
      const r = await adapter.join();
      setState('joined', { sessionId: r.sessionId, role, stack: c.stack, arm: c.arm });
      if (!window.__c4tick) window.__c4tick = setInterval(() => { tick().catch((e) => C4X.log('tick_error', { e: String(e) })); }, 200);
      return r;
    },
    /** Arm the ladder after warm-up (spec §3.2); records the per-remote baseline media age. */
    arm() {
      const base = Object.fromEntries(cfg.remotes.map((k) => { const xs = (C4X.FRESH[k] || []).slice(-50).map((s) => s.age).sort((a, b) => a - b); return [k, xs.length ? xs[xs.length >> 1] : null]; }));
      D.baseline = base; D.armed = true; setState('healthy', { baseline: base, sessionId: adapter.sessionId() });
      return base;
    },
    /** A driver-scheduled action (targeted tests, e.g. healthy-session rebuild at t=20 s). */
    async driverAction(kind) { D.tDetect = D.tDetect || C4X.now(); setState(kind === 'rebuild' ? 'rebuilding' : 'restarting', { trigger: 'scheduled' }); return act(kind); },
    /** TEST ONLY: a recovery not made by the driver (spec §6.3). */
    async plantRogue() { try { await adapter.plantRogue(); } catch (e) { C4X.log('rogue_error', { e: String(e) }); } return VIOLATIONS.length; },
    status() {
      const h = adapter ? health() : null;
      return { t: C4X.now(), role, stack: cfg && cfg.stack, state: D.state, sessionId: adapter && adapter.sessionId(), terminated: adapter && adapter.isTerminated(), gen: C4X.generation, health: h, actions: D.actions.length, violations: VIOLATIONS.length, observerDetected: !!D.observerDetected, busy: D.busy };
    },
    async leave() { D.armed = false; if (adapter) await attribution.run('leave', () => adapter.leave()); setState('left'); },
    dump() {
      return { cfg: { ...cfg, lk: cfg && cfg.lk ? { url: cfg.lk.url } : undefined }, params: P, driver: D, violations: VIOLATIONS, log: C4X.LOG, frames: C4X.dumpFrames(), fresh: C4X.FRESH, status: this.status(), sdk: window.LivekitClient ? window.LivekitClient.version : null };
    },
  };
})();
